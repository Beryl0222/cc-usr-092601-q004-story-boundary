{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "文化短视频事实边界台领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "SOURCE_REGISTERED",
        "CLAIM_PROPOSED",
        "TRANSLATION_REVIEWED",
        "RELEASE_POSTED",
        "CORRECTION_PROPAGATED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "source_record",
        "fact_claim",
        "video_segment",
        "channel_release"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "payload_required_by_event": {
    "CLAIM_PROPOSED": [
      "claim_kind",
      "source_ref"
    ],
    "RELEASE_POSTED": [
      "channel_id",
      "content_hash"
    ],
    "CORRECTION_PROPAGATED": [
      "supersedes",
      "scope"
    ]
  },
  "additionalProperties": false
}
